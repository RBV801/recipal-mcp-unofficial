# Copy to .env and fill in. Never commit .env.
#
# Required. From your ReciPal account settings -> API access.
# API access requires an active paid ReciPal subscription.
RECIPAL_API_KEY=your_key_here

# --- Optional safety switches (all off by default) -------------------------
#
# Enable delete_recipe and delete_recipe_ingredient. These permanently destroy
# data and ReciPal has no undo. Leave unset unless you need them.
# RECIPAL_MCP_ALLOW_DELETE=1
#
# Enable recipal_request, which can call any ReciPal endpoint with any method.
# Useful for discovering undocumented fields; broad in what it permits.
# RECIPAL_MCP_ENABLE_RAW=1

# --- Optional diagnostics --------------------------------------------------
#
# Log full request bodies to stderr. Bodies contain your recipe data, and your
# MCP client probably writes stderr to a file, so leave this off routinely.
# RECIPAL_MCP_DEBUG=1
#
# Number of retries on HTTP 429 (default 3, max 10).
# RECIPAL_MCP_MAX_RETRIES=3

# --- Optional endpoint override -------------------------------------------
#
# Defaults to https://www.recipal.com/api/v1. Must be https, and must be a
# recipal.com host unless RECIPAL_MCP_ALLOW_CUSTOM_BASE=1 is also set — your
# API key is sent to whatever this points at.
# RECIPAL_API_BASE=https://www.recipal.com/api/v1
# RECIPAL_MCP_ALLOW_CUSTOM_BASE=1
