{
  "name": "recipal-mcp-unofficial",
  "version": "0.6.2",
  "type": "module",
  "description": "Unofficial MCP server for the ReciPal nutrition-label API \u2014 recipes, ingredients, subrecipes, labels, and bulk clone/swap.",
  "license": "Apache-2.0",
  "author": "Rakmun Bryant-Vick",
  "files": ["build"],
  "homepage": "https://github.com/RBV801/recipal-mcp-unofficial#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RBV801/recipal-mcp-unofficial.git"
  },
  "bugs": {
    "url": "https://github.com/RBV801/recipal-mcp-unofficial/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "recipal",
    "nutrition",
    "nutrition-facts",
    "food-labeling",
    "claude"
  ],
  "bin": {
    "recipal-mcp-unofficial": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "gen:docs": "node scripts/gen-tools-doc.mjs",
    "test": "node --test test/smoke.test.mjs",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "verify": "npm run typecheck && npm run build && npm run gen:docs && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
